# Documents clients reçus (PDF de demandes de devis, factures…).
# Ils contiennent des données personnelles réelles — noms, téléphones,
# adresses. Leur place est le bucket privé `documents` de Supabase, pas
# l'historique git, d'où on ne peut plus les retirer sans réécriture.
pdf/
"pdf "/
*.pdf

# Artefacts locaux du CLI Supabase : versions des services et infos de liaison
# du projet, régénérés à chaque `supabase link`. Propres à un poste, ils n'ont
# rien à faire dans le dépôt.
supabase/.temp/
